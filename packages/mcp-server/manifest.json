{
  "dxt_version": "0.2",
  "name": "fortnox-mcp-wrapper-mcp",
  "version": "0.0.1",
  "description": "The official MCP Server for the Fortnox Mcp Wrapper API",
  "author": {
    "name": "Fortnox Mcp Wrapper"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stainless-sdks/fortnox-mcp-wrapper-typescript.git"
  },
  "homepage": "https://github.com/stainless-sdks/fortnox-mcp-wrapper-typescript/tree/main/packages/mcp-server#readme",
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/index.js"],
      "env": {
        "FORTNOX_MCP_WRAPPER_API_KEY": "${user_config.FORTNOX_MCP_WRAPPER_API_KEY}"
      }
    }
  },
  "user_config": {
    "FORTNOX_MCP_WRAPPER_API_KEY": {
      "title": "api_key",
      "description": "",
      "required": false,
      "type": "string"
    }
  },
  "tools": [],
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": ["api"]
}
